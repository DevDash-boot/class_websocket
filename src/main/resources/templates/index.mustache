<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>STOMP</title>
    <style>
        body {
            margin: 20px;
            font-family: Arial, sans-serif;
        }

        nav a {
            padding: 8px 15px;
            margin-right: 10px;
            background: #666;
            color: white;
            text-decoration: none;
        }

        .chat-area {
            border: 1px solid #ccc;
            height: 300px;
            padding: 10px;
            overflow-y: scroll;
            background: #f9f9f9;
        }

        .message {
            padding: 5px 10px;
            margin: 3px 0;
            background: white;
            border-radius: 8px;
            max-width: 80%;
        }

        form {
            margin-top: 10px;
            display: flex;
            gap: 10px;
        }

        input {
            flex: 1;
            padding: 8px;
        }

        button {
            padding: 8px 15px;
            background: #007bff;
            color: white;
            border: none;
        }
    </style>
    <!-- STOMP 클라이언트 라이브러리  -->
    <script src="https://cdn.jsdelivr.net/npm/@stomp/stompjs@7.5.0/bundles/stomp.umd.min.js"></script>
</head>
<body>
<nav>
    <a href="/room/1">1번 방</a>
    <a href="/room/2">2번 방</a>
    <a href="/room/3">3번 방</a>
</nav>

<h3>채팅(STOMP)</h3>
<p id="status">서버에 연결하는 중...</p>

<div class="chat-area" id="chatArea">
    {{#chats}}
        <div class="message">{{msg}}</div>
    {{/chats}}
</div>

<form id="chatForm">
    <input type="text" name="sender" id="sender" placeholder="이름" value="익명" required autofocus>
    <input type="text" name="msg" id="msg" placeholder="메시지 입력" required autofocus>
    <button type="submit">전송</button>
</form>

<script>
    const roomId = `{{roomId}}`; // 서버가 그려 준 현재 방 번호
    const chatArea = document.getElementById('chatArea');
    const status = document.getElementById('status');
    const chatForm = document.getElementById('chatForm');
    const msgInput = document.getElementById('msg');

    // 받은 메세지를 화면 맨 아래에 추가한다.
    function appendMessage(sender, msg) {
        const div = document.createElement("div");
        div.className = "message";
        const nameSpan = document.createElement("span");
        nameSpan.className = 'name';
        nameSpan.textContent = sender;
        div.appendChild(nameSpan);
        div.appendChild(document.createTextNode(msg));
        chatArea.appendChild(div);
        chatArea.scrollTop = chatArea.scrollHeight;
    }

    // 1. STOMP 클라이언트를 만든다.
    const protocol = location.protocol === 'https:' ? 'wss://' : 'ws://';
    const client = new StompJs.Client({
        brokerURL: protocol + location.host + "/ws-stomp",
        reconnectDelay: 5000   // 연결이 끊어지면 5초마다 자동 연결
    });

    // 2. 연결이 되면 이 방의 주소를 구독한다.
    client.onConnect = () => {
        status.textContent = "서버와 연결됨(STOMP) : " + roomId + "번 방";
        client.subscribe('/sub/chat/' + roomId, (message) => {
            // message.body는 JSON 문자열
            const dto = JSON.parse(message.body);
            appendMessage(dto.sender, dto.msg);
        })
    }

    // 3. 연결이 끊기면 자동으로 연결 시도
    client.onWebSocketClose = () => {
        alert("잠시 연결 중단. 자동으로 연결 처리 중...");
    }

    // 4. 서버가 ERROR 프레임을 보내면 콘솔에 남긴다.
    client.onStompError = (frame) => {
        console.log("STOMP 오류 : ", frame.headers['message']);
    }

    // 5. 전송 : JSON으로 변경해서 /pub/chat/방번호 로 던진다.
    chatForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const msg = msgInput.value.trim();
        if (msg === '') return;
        if (!client.connected) {
            alert('서버와 연결되어 있지 않습니다.');
            return;
        }
        const dto = {sender: document.getElementById("sender").value, msg: msg}

        client.publish({destination: '/pub/chat/' + roomId, body: JSON.stringify(dto)});

        msgInput.value = '';
        msgInput.focus();
    });

    // 처음 그려진 메시지 중 최신 메시지가 보이도록 스크롤을 맨 아래로 내린다.
    chatArea.scrollTop = chatArea.scrollHeight;

    // 연결 시작
    client.activate();

</script>
</body>
</html>